# ---------------------------------------------------------------------------
# Digital Doppelgänger — environment template
#
# The app works fully offline with zero environment variables.
# Everything below is optional and build-time only.
# ---------------------------------------------------------------------------

# Base path for the built site.
#   GitHub Pages project site  -> /digital-doppelganger/
#   Custom domain / root host  -> /
VITE_BASE=/digital-doppelganger/

# ---------------------------------------------------------------------------
# AI provider (OPTIONAL)
#
# There is NO server in this project. AI mode is configured by the end user at
# runtime in Settings → AI enhancement, and the key is stored in their browser
# only. Do NOT bake a provider key into a build: anything prefixed with VITE_
# is embedded in the shipped JavaScript bundle and is public.
#
# Reserve variable names only. Never commit real values.
# ---------------------------------------------------------------------------
# AI_PLACEHOLDER_BASE_URL=https://api.openai.com/v1
# AI_PLACEHOLDER_MODEL=gpt-4o-mini
